# Copy these values into the compose environment or a protected local env file.
AUTH_MODE=trusted_lan
TRUSTED_NETWORKS=127.0.0.1/32,::1/128,192.0.2.0/24,198.51.100.0/24,203.0.113.0/24
SESSION_SECRET=replace-with-a-long-random-value
RAGFLOW_API_TOKEN=replace-with-a-dedicated-ragflow-api-token

# Set AUTH_MODE=wecom only after the WeCom app and callback domain are ready.
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=https://knowledge.example.com/internal-api/auth/wecom/callback
COOKIE_SECURE=1
